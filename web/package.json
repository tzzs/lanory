{
  "name": "lanory-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lanory web UI — home network topology and monitoring",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
