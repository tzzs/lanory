# Lanory UCI configuration (/etc/config/lanory)
#
# This file is the single place a user edits. The init script turns it into
# /etc/lanory/config.yaml on every start, so the service always follows UCI.
#
# Everything here is read-only with respect to the router's own network
# configuration: Lanory never writes to /etc/config/network, dhcp, firewall,
# dnsmasq or the routing table.

config lanory 'main'
	# Start on boot. Set to 0 to keep the package installed but idle.
	option enabled '1'
	# Listen address. 0.0.0.0 exposes the UI on the LAN; change to 127.0.0.1 and
	# put a reverse proxy in front if you want it elsewhere.
	option listen '0.0.0.0'
	option port '8787'
	# Reverse proxy prefix, e.g. /lanory.
	option base_path ''
	# Where the SQLite database and any exported data live. Preserved on upgrade
	# and uninstall.
	option data_dir '/var/lib/lanory'
	# Regenerate /etc/lanory/config.yaml from this file on every start. Set to 0
	# if you hand-maintain the YAML instead.
	option generate_config '1'
	# Generate an access token in /etc/lanory/token on first start and require it
	# for API access. It is logged once so you can copy it. Set to 0 only when a
	# reverse proxy already authenticates every request, because without a token
	# anyone on the LAN can read network data and trigger scans.
	option generate_token '1'

config discovery 'discovery'
	# Background discovery. Disabling it leaves the last known state visible.
	option enabled '1'
	# How often to re-read interfaces, FDB, neighbours and leases.
	option interval '10m'

config monitoring 'monitoring'
	option enabled '1'

config logging 'logging'
	# debug | info | warn | error
	option level 'info'
