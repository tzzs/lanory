#!/bin/sh /etc/rc.common
# Lanory init script for procd (OpenWrt / iStoreOS).
#
# Behaviour mirrors the systemd unit in packaging/linux/lanory.service:
#   start     generate /etc/lanory/config.yaml from UCI, then start the service
#   stop      stop the service, leave the database alone
#   restart   stop + start
#   status    report whether the service is running (procd + health probe)
#   enable    autostart on boot (procd "enable" is provided by rc.common)
#   disable   no autostart
#
# Logging goes to the system log via procd's stdout redirection, so `logread -e
# lanory` shows the service output. There is no separate log file by default:
# /var/log on OpenWrt is tmpfs and a rotating file on flash is a bad idea.
#
# Data lives in /var/lib/lanory and survives upgrades and uninstalls.
# The service is read-only with respect to the router: it reads interface state,
# the bridge FDB, ARP/NDP and DHCP leases, and it never writes to UCI.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/lanory
CONFIG_YAML=/etc/lanory/config.yaml
DATA_DIR=/var/lib/lanory

# config_get_bool / config_get come from /lib/functions.sh, loaded by rc.common.

# lanory_bool <uci-value> <default> — normalise a UCI boolean.
lanory_bool() {
	case "$1" in
		1|on|true|yes|enabled) echo 1 ;;
		0|off|false|no|disabled) echo 0 ;;
		*) echo "$2" ;;
	esac
}

# lanory_generate_config writes /etc/lanory/config.yaml from UCI.
#
# The YAML is generated rather than edited by hand so a user only ever touches
# one file. The file is rewritten on every start, which keeps it in sync with
# UCI (the Web UI writes UCI, not YAML). If the file already exists and UCI has
# no section, the existing file is left alone so a hand written configuration
# still works.
lanory_generate_config() {
	local enabled host port data_dir discovery_enabled monitor_enabled
	local discovery_interval log_level base_path

	config_load lanory
	config_get enabled      main enabled      1
	config_get host         main listen       0.0.0.0
	config_get port         main port         8787
	config_get data_dir     main data_dir     "$DATA_DIR"
	config_get base_path    main base_path    ""
	config_get discovery_enabled discovery enabled 1
	config_get discovery_interval discovery interval 10m
	config_get monitor_enabled monitoring enabled 1
	config_get log_level    logging level     info

	# If the user disabled config generation, respect that.
	config_get generate main generate_config 1
	[ "$(lanory_bool "$generate" 1)" = "1" ] || {
		logger -t lanory "config generation disabled in UCI; using $CONFIG_YAML as is"
		return 0
	}

	mkdir -p "$(dirname "$CONFIG_YAML")" "$data_dir" 2>/dev/null

	tmp="$CONFIG_YAML.tmp.$$"
	cat > "$tmp" <<EOF
# Generated by /etc/init.d/lanory from /etc/config/lanory on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Do not edit: change /etc/config/lanory (or set main.generate_config=0 and edit
# this file, accepting that Lanory will then no longer follow UCI).
server:
  host: "$host"
  port: $port
  base_path: "$base_path"
database:
  path: "$data_dir/lanory.db"
  retention_days: 30
discovery:
  enabled: $(lanory_bool "$discovery_enabled" 1)
  interval: "$discovery_interval"
  auto_detect_subnets: true
  max_concurrency: 16
  scan_timeout: 500ms
  rate_limit: 64
collectors:
  openwrt: true
  arp: true
  ndp: true
  dhcp: true
  fdb: true
  lldp: false
  mdns: false
  ssdp: false
  snmp: false
  scan: false
monitoring:
  enabled: $(lanory_bool "$monitor_enabled" 1)
  interval: 60s
  timeout: 3s
  failure_threshold: 3
  recover_confirm: 1
  interface_refresh: 30s
  device_refresh: 60s
topology:
  auto_layout: true
  preserve_manual_layout: true
  prefer_confirmed_edges: true
  unverified_edge_threshold: 0.6
auth:
  enabled: false
  allow_lan: true
logging:
  level: "$log_level"
  pretty: true
demo:
  enabled: false
EOF

	# Keep the token out of the world readable YAML: it comes from
	# /etc/lanory/token, mode 0600, and is read by the binary through
	# LANORY_AUTH_TOKEN (see procd env below). See README.md.
	if [ -s /etc/lanory/token ]; then
		chmod 600 /etc/lanory/token
	fi
	mv "$tmp" "$CONFIG_YAML"
	chmod 644 "$CONFIG_YAML"
}

lanory_running() {
	pidof lanory >/dev/null 2>&1
}

start_service() {
	config_load lanory
	local enabled data_dir
	config_get enabled main enabled 1
	config_get data_dir main data_dir "$DATA_DIR"

	if [ "$(lanory_bool "$enabled" 1)" != "1" ]; then
		logger -t lanory "disabled in /etc/config/lanory (lanory.main.enabled=0); not starting"
		return 0
	fi

	lanory_generate_config

	mkdir -p "$data_dir"
	# The database must be writable by the service only.
	chmod 750 "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG_YAML"
	# Working directory is the data dir so a relative path in the YAML cannot
	# escape into /.
	procd_set_param cwd "$data_dir"
	# Log to the system log. procd captures stdout/stderr and forwards it to
	# logd (logread -e lanory). 125 lines is enough to survive a restart.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	# Restart if the process grows beyond a sane footprint for a router; the Go
	# runtime is compact but a runaway loop should not take the router down.
	procd_set_param limits nofile="1024 1024"
	# The token file, when present, is passed as an environment variable so it
	# never appears in `ps` or in the generated YAML.
	if [ -s /etc/lanory/token ]; then
		procd_set_param env LANORY_AUTH_TOKEN="$(cat /etc/lanory/token)"
	fi
	procd_close_instance

	logger -t lanory "started with $CONFIG_YAML, data in $data_dir"
}

stop_service() {
	logger -t lanory "stopping"
}

service_triggers() {
	# Reload when the network is reconfigured: an interface that comes up or
	# changes its role must be discovered promptly.
	procd_add_reload_trigger "network"
	procd_add_reload_trigger "lanory"
}

reload_service() {
	# A reload regenerates the YAML and restarts the process. The database is
	# untouched, so history survives.
	stop
	start
}

# status is used by `service lanory status` and by the LuCI page. rc.common's
# default status only checks the procd instance; this adds an HTTP health probe
# so a crashed-but-respawned loop is visible too.
status_service() {
	if ! lanory_running; then
		echo "lanory is not running"
		return 1
	fi
	local port
	config_load lanory
	config_get port main port 8787
	# wget is available on OpenWrt as busybox wget. A failure here does not
	# change the exit code: the process may still be starting.
	if command -v wget >/dev/null 2>&1; then
		if wget -q -O /dev/null -T 2 "http://127.0.0.1:$port/api/v1/health" 2>/dev/null; then
			echo "lanory is running (health endpoint ok on port $port)"
			return 0
		fi
		echo "lanory is running but the health endpoint on port $port did not answer yet"
		return 0
	fi
	echo "lanory is running"
	return 0
}
